#!/bin/bash
# Checks that the shared LSST install activates correctly and that the
# custom DECam filters registered by custom_filters.yml are recognized by a
# butler registry after `register-instrument` - the actual downstream
# mechanism real analysis butler repos rely on to pick up new filters.
#
# Generated by the lsst_custom_filters ansible role - re-run
# custom_filters.yml to regenerate after changing group_vars. Do not
# hand-edit, changes will be overwritten on the next run.
#
# Safe to run any time, any number of times: only creates a throwaway
# butler repo under $TMPDIR (or /tmp), deleted on exit. Does not touch any
# real butler repo.
#
# Usage: {{ lsst_custom_filters_testing_dir }}/{{ lsst_custom_filters_check_script_name }}

set -eo pipefail

source "{{ lsst_custom_filters_setup_env_script }}"

# Explicit template with no dot in the directory name: butler create infers
# the config serialization format from what looks like a file extension on
# the repo path, and the default mktemp template (tmp.XXXXXXXX) trips it up
# - the random suffix after the dot gets read as the format, e.g. error
# "Unsupported format for Config serialization: krc9h6cqw2".
tmp_repo="$(mktemp -d "${TMPDIR:-/tmp}/lsst_custom_filters_check_XXXXXX")"
trap 'rm -rf "$tmp_repo"' EXIT

butler create "$tmp_repo"
butler register-instrument "$tmp_repo" lsst.obs.decam.DarkEnergyCamera

python3 - "$tmp_repo" <<'PYEOF'
import sys
from lsst.daf.butler import Butler

butler = Butler(sys.argv[1])
found = {
    (r.name, r.band)
    for r in butler.registry.queryDimensionRecords("physical_filter", instrument="DECam")
}

expected = set([
{% for f in lsst_custom_filters %}
    ("{{ f.physical_filter }}", "{{ f.band }}"),
{% endfor %}
])
missing = expected - found
if missing:
    raise SystemExit(f"Custom filters missing from butler registry after register-instrument: {missing}")
print("butler registry: all custom filters recognized after register-instrument")
PYEOF
