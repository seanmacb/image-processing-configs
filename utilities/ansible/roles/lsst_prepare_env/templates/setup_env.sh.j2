# Source this to fully activate the shared LSST Science Pipelines install
# at {{ lsst_install_dir }} in your current shell:
#   source {{ lsst_install_dir }}/{{ lsst_prepare_env_script_name }}
#
# Generated by the lsst_prepare_env ansible role - re-run prepare_env.yml to
# regenerate after changing group_vars. Do not hand-edit; changes will be
# overwritten on the next run.

source "{{ lsst_install_dir }}/lsst_stack/loadLSST.sh"
setup lsst_distrib

# Prefer any locally modified/checked-out eups packages under repos/ (e.g.
# the lsst_custom_filters role's obs_decam/skymap checkouts) over the
# versions from lsst_distrib above. `eups setup -j -r` only applies to the
# shell it's run in, so every new shell/job has to redo this - that's why
# this whole script exists to be sourced rather than baked into the shared
# install itself. Any subdirectory of repos/ that looks like an eups
# package (has a ups/ metadata dir) is picked up automatically, so this
# keeps working as more locally modified packages are added later.
lsst_prepare_env_repos_dir="{{ lsst_install_dir }}/repos"
if [ -d "${lsst_prepare_env_repos_dir}" ]; then
    for lsst_prepare_env_pkg_dir in "${lsst_prepare_env_repos_dir}"/*/; do
        if [ -d "${lsst_prepare_env_pkg_dir}ups" ]; then
            setup -j -r "${lsst_prepare_env_pkg_dir%/}"
        fi
    done
    unset lsst_prepare_env_pkg_dir
fi
unset lsst_prepare_env_repos_dir

# The butler repo being processed is a shared folder used by every
# {{ lsst_shared_group }} member. Set a group-writable umask so files and
# directories created in it (butler ingest, pipetask runs, ...) stay
# read/write for the whole group instead of just their creator.
umask 0002
