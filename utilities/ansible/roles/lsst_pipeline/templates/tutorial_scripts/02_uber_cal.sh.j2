#!/bin/bash
{% set sbatch_job_name = "rc2_subset-02_uber_cal" %}
{% set sbatch_resources = lsst_rc2_subset_tutorial_slurm.uber_cal %}
{% include "_sbatch_header.j2" %}
#
# Tutorial Part 4: full focal plane calibration (fgcm, gbdes, then apply).
# https://pipelines.lsst.io/getting-started/uber-cal.html
#
# Runs standalone (bash 02_uber_cal.sh) or as a SLURM batch job
# (sbatch 02_uber_cal.sh) - the #SBATCH lines above are plain comments to
# bash, only sbatch reads them.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - re-run
# site.yml to regenerate after changing group_vars. Do not hand-edit,
# changes will be overwritten on the next run.

script_dir="{{ lsst_install_dir }}/demo_data/tutorial_scripts"
source "${script_dir}/common.sh"

# Known issue (see lsst-alerts-at-uzh docs): fgcm errors out unless run
# single-core, so this ignores TUTORIAL_CORES/-j on purpose - do not raise
# it.
pipetask run --register-dataset-types \
    -j 1 \
    -b "${BUTLER_REPO}" \
    -i "u/${USER}/single_frame" \
    -o "u/${USER}/fgcm" \
    -p "${PIPELINE}#fgcm"

pipetask run --register-dataset-types \
    -j "${TUTORIAL_CORES}" \
    -b "${BUTLER_REPO}" \
    -i "u/${USER}/single_frame" \
    -o "u/${USER}/gbdes" \
    -p "${PIPELINE}#gbdesAstrometricFit"

pipetask run --register-dataset-types \
    -j "${TUTORIAL_CORES}" \
    -b "${BUTLER_REPO}" \
    -i "u/${USER}/single_frame,u/${USER}/fgcm,u/${USER}/gbdes" \
    -o "u/${USER}/source_calibration" \
    -p "${PIPELINE}#source_calibration"
