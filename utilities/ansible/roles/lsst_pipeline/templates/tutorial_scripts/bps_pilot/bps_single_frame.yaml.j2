# BPS submit config for singleFrame, distributed across multiple Slurm
# nodes via ctrl_bps_parsl (proof-of-principle, see 01_single_frame_bps.sh).
# ${BUTLER_REPO}/${PIPELINE}/${DATA_QUERY}/${USER} are expanded by
# lsst.ctrl.bps from the calling shell's environment at submit time.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - do not
# hand-edit, re-run site.yml to regenerate.

wmsServiceClass: lsst.ctrl.bps.parsl.ParslService

pipelineYaml: "${PIPELINE}#singleFrame"

payload:
  payloadName: rc2_subset_single_frame_bps
  butlerConfig: "${BUTLER_REPO}"
  inCollection: "HSC/RC2/defaults"
  output: "u/${USER}/single_frame_bps"
  dataQuery: "${DATA_QUERY}"

computeSite: slurm

site:
  slurm:
    class: lsst.ctrl.bps.parsl.sites.Slurm
    nodes: {{ lsst_rc2_subset_tutorial_bps_pilot.single_frame.nodes }}
    cores_per_node: {{ lsst_rc2_subset_tutorial_bps_pilot.single_frame.cores_per_node }}
    mem_per_node: {{ lsst_rc2_subset_tutorial_bps_pilot.single_frame.mem_per_node_gb }}
    walltime: "{{ lsst_rc2_subset_tutorial_bps_pilot.single_frame.walltime }}"
{% if lsst_rc2_subset_tutorial_slurm_partition %}
    scheduler_options: "#SBATCH --partition={{ lsst_rc2_subset_tutorial_slurm_partition }}"
{% endif %}
