#!/bin/bash
{% set sbatch_job_name = "rc2_subset-01_single_frame" %}
{% set sbatch_resources = lsst_rc2_subset_tutorial_slurm.single_frame %}
{% include "_sbatch_header.j2" %}
#
# Tutorial Part 2: single frame calibration.
# https://pipelines.lsst.io/getting-started/singleframe.html
#
# By far the most time-consuming step (~11h single-core, per the upstream
# tutorial) - the one most worth handing real SLURM resources via -j.
#
# Runs standalone (bash 01_single_frame.sh) or as a SLURM batch job
# (sbatch 01_single_frame.sh) - the #SBATCH lines above are plain comments
# to bash, only sbatch reads them.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - re-run
# site.yml to regenerate after changing group_vars. Do not hand-edit,
# changes will be overwritten on the next run.

script_dir="{{ lsst_install_dir }}/demo_data/tutorial_scripts"
source "${script_dir}/common.sh"

pipetask run --register-dataset-types \
    -j "${TUTORIAL_CORES}" \
    -b "${BUTLER_REPO}" \
    -i HSC/RC2/defaults \
    -o "u/${USER}/single_frame" \
    -p "${PIPELINE}#singleFrame"
