#!/bin/bash
{% set sbatch_job_name = "rc2_subset-06_forced_photometry" %}
{% set sbatch_resources = lsst_rc2_subset_tutorial_slurm.forced_photometry %}
{% include "_sbatch_header.j2" %}
#
# Tutorial Part 6 (second half): forced photometry on the coadds.
# https://pipelines.lsst.io/getting-started/photometry.html
#
# Runs standalone (bash 06_forced_photometry.sh) or as a SLURM batch job
# (sbatch 06_forced_photometry.sh) - the #SBATCH lines above are plain
# comments to bash, only sbatch reads them.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - re-run
# site.yml to regenerate after changing group_vars. Do not hand-edit,
# changes will be overwritten on the next run.

script_dir="{{ lsst_install_dir }}/demo_data/tutorial_scripts"
source "${script_dir}/common.sh"

# Known issue (see lsst-alerts-at-uzh docs): the upstream tutorial's
# "forced_objects" subset fails at quantum-graph build with missing
# dataset types (pvi, deepCoadd_Sersic_multiprofit) that earlier tutorial
# steps don't produce. Run forcedPhotCoadd on its own instead, per the
# documented workaround - the full forced_objects subset would need extra
# prerequisite tasks this tutorial sequence doesn't run.
pipetask run --register-dataset-types \
    -j "${TUTORIAL_CORES}" \
    -b "${BUTLER_REPO}" \
    -i "u/${USER}/coadd_meas" \
    -o "u/${USER}/objects" \
    -p "${PIPELINE}#forcedPhotCoadd" \
    -d "${DATA_QUERY}"
