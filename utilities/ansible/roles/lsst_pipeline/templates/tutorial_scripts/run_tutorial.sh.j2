#!/bin/bash
{% set sbatch_job_name = "rc2_subset-tutorial" %}
{% set sbatch_resources = lsst_rc2_subset_tutorial_slurm.run_tutorial %}
{% include "_sbatch_header.j2" %}
#
# Runs the whole rc2_subset "Getting Started" tutorial
# (https://pipelines.lsst.io/getting-started/) by calling each numbered
# script in this directory in order. Each step is also a standalone script
# you can run or resubmit on its own to retry or resume from a specific
# point - this is just the "run everything in sequence" convenience.
#
# Usage:
#   ./run_tutorial.sh          # run every step, in the foreground
#   sbatch run_tutorial.sh     # submit the whole sequence as one SLURM job
#   ./run_tutorial.sh 03       # resume from step 03 onward (steps < 03 skipped)
#
# The #SBATCH lines above are plain comments to bash, only sbatch reads
# them - and only apply to the whole sequence run as one job. Submit an
# individual NN_*.sh script instead for per-step SLURM resource requests.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - re-run
# site.yml to regenerate after changing group_vars. Do not hand-edit,
# changes will be overwritten on the next run.

set -eo pipefail
script_dir="{{ lsst_install_dir }}/demo_data/tutorial_scripts"

# $((10#...)) forces base-10 parsing so a leading zero (e.g. "08") isn't
# misread as an invalid octal literal.
start_step=$((10#${1:-00}))

steps=(
    01_single_frame.sh
    02_uber_cal.sh
    03_make_warps.sh
    04_coadds.sh
    05_coadd_measurement.sh
    06_forced_photometry.sh
)

for step in "${steps[@]}"; do
    step_num=$((10#${step%%_*}))
    if [ "${step_num}" -lt "${start_step}" ]; then
        echo "run_tutorial.sh: skipping ${step} (before requested start step)" >&2
        continue
    fi
    echo "run_tutorial.sh: running ${step}" >&2
    bash "${script_dir}/${step}"
done
