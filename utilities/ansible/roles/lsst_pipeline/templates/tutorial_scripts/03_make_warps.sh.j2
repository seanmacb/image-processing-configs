#!/bin/bash
{% set sbatch_job_name = "rc2_subset-03_make_warps" %}
{% set sbatch_resources = lsst_rc2_subset_tutorial_slurm.make_warps %}
{% include "_sbatch_header.j2" %}
#
# Tutorial Part 5 (first half): warp calibrated images onto the skymap.
# https://pipelines.lsst.io/getting-started/coaddition.html
#
# Runs standalone (bash 03_make_warps.sh) or as a SLURM batch job
# (sbatch 03_make_warps.sh) - the #SBATCH lines above are plain comments
# to bash, only sbatch reads them.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - re-run
# site.yml to regenerate after changing group_vars. Do not hand-edit,
# changes will be overwritten on the next run.

script_dir="{{ lsst_install_dir }}/demo_data/tutorial_scripts"
source "${script_dir}/common.sh"

# Known issue (see lsst-alerts-at-uzh docs): the upstream tutorial's
# "makeWarp" subset no longer exists - it was split into makeDirectWarp
# (non-PSF-matched) and makePsfMatchedWarp (PSF-matched, for artifact
# rejection). Run both, as the fix documents.
pipetask run --register-dataset-types \
    -j "${TUTORIAL_CORES}" \
    -b "${BUTLER_REPO}" \
    -i "u/${USER}/source_calibration,u/${USER}/gbdes,u/${USER}/fgcm" \
    -o "u/${USER}/warps" \
    -p "${PIPELINE}#makeDirectWarp,makePsfMatchedWarp" \
    -d "${DATA_QUERY}"
