#!/bin/bash
{% set sbatch_job_name = "rc2_subset-04_coadds" %}
{% set sbatch_resources = lsst_rc2_subset_tutorial_slurm.coadds %}
{% include "_sbatch_header.j2" %}
#
# Tutorial Part 5 (second half): coadd the warped images.
# https://pipelines.lsst.io/getting-started/coaddition.html
#
# More memory-intensive than warping, per the upstream tutorial - raise
# lsst_rc2_subset_tutorial_slurm_mem if this OOMs under SLURM.
#
# Runs standalone (bash 04_coadds.sh) or as a SLURM batch job
# (sbatch 04_coadds.sh) - the #SBATCH lines above are plain comments to
# bash, only sbatch reads them.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - re-run
# site.yml to regenerate after changing group_vars. Do not hand-edit,
# changes will be overwritten on the next run.

script_dir="{{ lsst_install_dir }}/demo_data/tutorial_scripts"
source "${script_dir}/common.sh"

pipetask run --register-dataset-types \
    -j "${TUTORIAL_CORES}" \
    -b "${BUTLER_REPO}" \
    -i "u/${USER}/warps" \
    -o "u/${USER}/coadds" \
    -p "${PIPELINE}#selectDeepCoaddVisits,assembleCoadd" \
    -d "${DATA_QUERY}"
