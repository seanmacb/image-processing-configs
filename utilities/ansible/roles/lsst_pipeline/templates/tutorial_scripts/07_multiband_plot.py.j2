#!/usr/bin/env python
# Tutorial Part 7: color-color diagram from the forced-photometry catalogs.
# https://pipelines.lsst.io/getting-started/multiband-analysis.html
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - do not
# hand-edit, re-run site.yml to regenerate.

import os

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

from lsst.daf.butler import Butler

TRACT = {{ lsst_rc2_subset_tutorial_tract }}
PATCH = {{ lsst_rc2_subset_tutorial_plot_patch }}

user = os.environ["USER"]
butler = Butler(os.environ["BUTLER_REPO"], collections=[f"u/{user}/objects", f"u/{user}/coadd_meas"])

sources = {}
photoCalibs = {}
for band in ("g", "r", "i"):
    sources[band] = butler.get("deepCoadd_forced_src", band=band, tract=TRACT, patch=PATCH)
    photoCalibs[band] = butler.get("deepCoadd_calexp.photoCalib", band=band, tract=TRACT, patch=PATCH)

mags = {band: photoCalibs[band].instFluxToMagnitude(sources[band], "base_PsfFlux") for band in sources}

refTable = butler.get("deepCoadd_ref", tract=TRACT, patch=PATCH)
isPrimary = refTable["detect_isPrimary"]
isDeblended = sources["r"]["deblend_nChild"] == 0
isStellar = sources["i"]["base_ClassificationExtendedness_value"] < 1.0
isExtended = sources["i"]["base_ClassificationExtendedness_value"] == 1.0
isGoodFlux = (
    ~sources["i"]["base_PsfFlux_flag"]
    & ~sources["r"]["base_PsfFlux_flag"]
    & ~sources["g"]["base_PsfFlux_flag"]
)

selections = {
    "stellar": isPrimary & isDeblended & isStellar & isGoodFlux,
    "extended": isPrimary & isDeblended & isExtended & isGoodFlux,
}
styles = {"stellar": dict(marker="o", c="k"), "extended": dict(marker="v", c="r")}

plt.figure(figsize=(4, 4), dpi=140)
for name, selected in selections.items():
    g = mags["g"][selected][:, 0]
    r = mags["r"][selected][:, 0]
    i = mags["i"][selected][:, 0]
    plt.scatter(g - r, r - i, edgecolors="none", s=4, label=name, **styles[name])
plt.xlabel("$g-r$")
plt.ylabel("$r-i$")
plt.legend()
plt.tight_layout()

out_path = "multiband_color_color.png"
plt.savefig(out_path)
print(f"wrote {out_path}")
