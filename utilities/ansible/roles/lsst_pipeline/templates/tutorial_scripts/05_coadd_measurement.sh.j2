#!/bin/bash
{% set sbatch_job_name = "rc2_subset-05_coadd_measurement" %}
{% set sbatch_resources = lsst_rc2_subset_tutorial_slurm.coadd_measurement %}
{% include "_sbatch_header.j2" %}
#
# Tutorial Part 6 (first half): detect, deblend, and measure sources on
# the coadds.
# https://pipelines.lsst.io/getting-started/photometry.html
#
# Runs standalone (bash 05_coadd_measurement.sh) or as a SLURM batch job
# (sbatch 05_coadd_measurement.sh) - the #SBATCH lines above are plain
# comments to bash, only sbatch reads them.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - re-run
# site.yml to regenerate after changing group_vars. Do not hand-edit,
# changes will be overwritten on the next run.

script_dir="{{ lsst_install_dir }}/demo_data/tutorial_scripts"
source "${script_dir}/common.sh"

pipetask run --register-dataset-types \
    -j "${TUTORIAL_CORES}" \
    -b "${BUTLER_REPO}" \
    -i "u/${USER}/coadds" \
    -o "u/${USER}/coadd_meas" \
    -p "${PIPELINE}#coadd_measurement" \
    -d "${DATA_QUERY}" \
    -c detection:detection.thresholdValue=250.0
