#!/bin/bash
# Shared setup sourced by the numbered tutorial step scripts in this
# directory - not meant to be run directly.
#
# Generated by the lsst_pipeline ansible role (rc2_subset.yml) - re-run
# site.yml to regenerate after changing group_vars. Do not hand-edit,
# changes will be overwritten on the next run.

set -eo pipefail

source "{{ lsst_install_dir }}/{{ lsst_prepare_env_script_name }}"
setup -j -r "{{ lsst_install_dir }}/demo_data/rc2_subset"

export BUTLER_REPO="{{ lsst_install_dir }}/demo_data/rc2_subset/SMALL_HSC/butler.yaml"
export PIPELINE="${DRP_PIPE_DIR}/pipelines/HSC/DRP-RC2_subset.yaml"
export DATA_QUERY="skymap = '{{ lsst_rc2_subset_tutorial_skymap }}' AND tract = {{ lsst_rc2_subset_tutorial_tract }} AND patch in ({{ lsst_rc2_subset_tutorial_patches }})"

# Cores to hand to pipetask's -j: prefer the SLURM allocation this script
# is actually running under (set whether launched via sbatch or srun), so
# a step submitted with `sbatch --cpus-per-task=N` uses N automatically
# instead of the #SBATCH default baked in at template time. Falls back to
# all cores on the machine when run directly outside SLURM.
if [ -n "${SLURM_CPUS_PER_TASK:-}" ]; then
    TUTORIAL_CORES="${SLURM_CPUS_PER_TASK}"
elif [ -n "${SLURM_JOB_CPUS_PER_NODE:-}" ]; then
    # e.g. "8" or "8(x2)" for a multi-node allocation - only the first
    # node's count is relevant since pipetask -j only parallelizes within
    # this one process/node.
    TUTORIAL_CORES="${SLURM_JOB_CPUS_PER_NODE%%(*}"
else
    TUTORIAL_CORES="$(nproc)"
fi
export TUTORIAL_CORES

echo "$(basename "$0"): using -j ${TUTORIAL_CORES}, output collections under u/${USER}/" >&2
